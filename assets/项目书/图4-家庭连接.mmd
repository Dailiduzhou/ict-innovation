flowchart LR
  MEM["个人长期记忆<br/>（私人，按用户隔离）"] --> AUTH{"老人授权<br/>对象 · 类别 · 范围"}
  AUTH -- 通过 --> PROJ["授权投影"]
  AUTH -- 拒绝 --> SIL["不发任何旁路提示<br/>（不告知「有一条不愿分享的内容」）"]
  PROJ --> P1["最近的生活<br/>少量近况 + 愿意分享的原话"]
  PROJ --> P2["下次聊什么<br/>联系前回顾、可接着聊的话题"]
  PROJ --> P3["需要你参与<br/>仅明确求助才有接手与反馈"]
  KID["子女真实留言"] --> CONF{"老人接收设置<br/>+ 本人确认"}
  CONF --> OLD["转达到老人端<br/>明确真实发送者，不代写不冒充"]
